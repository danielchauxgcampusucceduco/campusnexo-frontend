# Base URL of the Java backend. With the Vite dev proxy, /api and /ws are forwarded to localhost:8080.
VITE_API_URL=/api/v1
# STOMP endpoint (ws:// or wss://). Empty = derived from the page origin (/ws).
VITE_WS_URL=
# backend | simulation | auto (try the backend, fall back to the in-browser simulation)
VITE_DATA_SOURCE=auto
