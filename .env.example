# Base REST del backend Java. En desarrollo, el proxy de Vite envía /api y /ws a localhost:8080.
# En Vercel: https://<servicio-backend>.onrender.com/api/v1
VITE_API_URL=/api/v1
# Endpoint STOMP (ws:// o wss://). Vacío = el origen de la página + /ws.
# En Vercel: wss://<servicio-backend>.onrender.com/ws (Vercel no reenvía WebSocket).
VITE_WS_URL=
